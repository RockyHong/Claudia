{
  "enabledPlugins": {
    "fullstack-dev-skills@fullstack-dev-skills": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "super-bootstrap@super-bootstrap": true,
    "axioms@axioms-protocol": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));const f=d.tool_input?.file_path;if(f&&/\\\\.(js|ts|svelte|json|css|html)$/.test(f)){const{execSync}=require('child_process');try{execSync('npx @biomejs/biome check --fix --no-errors-on-unmatched '+JSON.stringify(f),{stdio:'ignore',cwd:d.cwd})}catch{}}\"",
            "timeout": 10,
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-model-posttool.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-model-pretool.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-model-pretool.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-channel.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); if echo \"$CLAUDE_PROJECT_DIR\" | grep -qE '[/\\\\]\\.claude[/\\\\]worktrees[/\\\\]'; then exit 0; fi; if echo \"$fp\" | grep -qE '\\.claude[/\\\\]worktrees[/\\\\]'; then echo 'BLOCKED: worktree-internal Read re-injects that worktree CLAUDE.md. Read-around: git show {branch}:<path> / Grep / Glob.' >&2; exit 2; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/consult-check-sessionstart.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/consult-check-check.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "super-bootstrap": {
      "source": {
        "source": "github",
        "repo": "RockyHong/super-bootstrap"
      }
    }
  }
}
